# cp .dev.vars.example .dev.vars でローカル用のシークレットを用意する

# ローカル開発では Cloudflare Access を通らないので、/api/* の JWT 検証を省く。本番では設定しない
DEV_DISABLE_ACCESS=true

# 本番では wrangler secret put で設定する（技術定義書 8章）
# ACCESS_TEAM_DOMAIN=https://<チーム名>.cloudflareaccess.com
# ACCESS_AUD=<Access アプリケーションの AUD タグ>

# OTLP受信口の取り込みトークン（技術定義書 8章）
INGEST_TOKEN=dev-ingest-token
