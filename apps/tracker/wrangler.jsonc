// D1・R2・Queue の ID は書かない。初回のデプロイで wrangler が自動で作って紐づける（README の「デプロイ」）。
// 独自ドメインで動かす場合は routes を追加する（技術定義書 9章）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "errorcloud",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_e/*", "/otlp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "errorcloud",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "errorcloud" }],
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "errorcloud-ingest" }],
    "consumers": [{ "queue": "errorcloud-ingest", "max_batch_size": 100, "max_batch_timeout": 5 }]
  },
  // 受信口の流量制限。プロジェクトとクライアントの組ごとに1分あたりの件数を絞る。
  // 無料プランで使えない場合はこの項目を消せば、流量制限なしで動く（技術定義書 11章）
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["0 18 * * *"] },
  "observability": { "enabled": true }
}
